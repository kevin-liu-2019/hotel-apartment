<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hotel.apartment.dal.mapper.OrderMapper">

    <select id="selectByOrderNo" resultType="com.hotel.apartment.dal.entity.Order">
        SELECT *
        FROM t_order
        WHERE order_no = #{orderNo}
          AND deleted = 0
        LIMIT 1
    </select>

</mapper>
